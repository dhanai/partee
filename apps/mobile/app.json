{
  "expo": {
    "name": "Parfade",
    "slug": "parfade",
    "scheme": [
      "parfade",
      "com.parfade.parfade-mobile"
    ],
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.parfade.parfade-mobile",
      "associatedDomains": [
        "applinks:parfade.com",
        "applinks:www.parfade.com"
      ],
      "infoPlist": {
        "CFBundleName": "Parfade",
        "CFBundleDisplayName": "Parfade",
        "ITSAppUsesNonExemptEncryption": false,
        "NSCalendarsUsageDescription": "Parfade can add rounds you host or join to your calendar when you tap Add to calendar.",
        "NSCalendarsFullAccessUsageDescription": "Parfade can add rounds you host or join to your calendar when you tap Add to calendar.",
        "NSRemindersUsageDescription": "Parfade uses this only as required by iOS when saving round events to your calendar.",
        "NSRemindersFullAccessUsageDescription": "Parfade uses this only as required by iOS when saving round events to your calendar."
      },
      "buildNumber": "32"
    },
    "android": {
      "label": "Parfade",
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "backgroundColor": "#1a3c2a",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.READ_CALENDAR",
        "android.permission.WRITE_CALENDAR"
      ],
      "package": "com.parfade.parfademobile"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-web-browser",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1a3c2a",
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "imageWidth": 260
        }
      ],
      "expo-notifications",
      [
        "expo-calendar",
        {
          "calendarPermission": "Parfade can add rounds you host or join to your calendar when you tap Add to calendar.",
          "remindersPermission": "Parfade uses this only as required by iOS when saving round events to your calendar."
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Parfade uses your location to show nearby rounds."
        }
      ],
      "expo-image",
      "expo-video",
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-3940256099942544~3347511713",
          "iosAppId": "ca-app-pub-7180905063701621~6055836793"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "0c6a06db-03f1-4c04-a226-7176089695d9"
      },
      "router": {}
    }
  }
}
