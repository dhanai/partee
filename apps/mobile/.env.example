# Site ORIGIN only — do NOT append /api (paths are /api/users/me, etc.)
#
# Game type titles/subtitles (Games tab, create flow) come from GET /api/game-types on THIS host.
# If you edit copy in Admin on production but the app points at localhost, you will see your
# local DATABASE_URL, not production — set EXPO_PUBLIC_API_BASE_URL to the same origin as admin.
#
# Local testing against the cloud server (simplest on a real device; no LAN Next):
#   EXPO_PUBLIC_API_BASE_URL=https://parfade.com
#   EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=<publishable key for the SAME Clerk env as that deployment>
# Then: npx expo start -c
#
# Local Next instead: simulator → http://localhost:3000 ; device on Wi‑Fi → http://192.168.x.x:3000
# and from repo root `npm run dev:lan`.
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000
# Optional. Share links (profile, round invites) use this origin. Defaults to https://parfade.com when unset.
# EXPO_PUBLIC_WEB_BASE_URL=https://parfade.com
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=

# AdMob (native builds only). Unit IDs are inlined at build time — EAS TestFlight builds do NOT read this file unless you mirror these in Expo → Environment variables (production).
# Optional: override App IDs from app.json (ca-app-pub-…~…) without editing the repo.
# EXPO_PUBLIC_ADMOB_APP_ID_IOS=
# EXPO_PUBLIC_ADMOB_APP_ID_ANDROID=
# Native Discover (inline feed) — omit locally to use Google test native ads; REQUIRED on EAS production or you’ll see sample ads in TestFlight.
# EXPO_PUBLIC_ADMOB_NATIVE_DISCOVER_IOS=
# EXPO_PUBLIC_ADMOB_NATIVE_DISCOVER_ANDROID=
# Game-end interstitial — same as above for production.
# EXPO_PUBLIC_ADMOB_INTERSTITIAL_GAME_END_IOS=
# EXPO_PUBLIC_ADMOB_INTERSTITIAL_GAME_END_ANDROID=
#
# Optional: some Discover ad slots show your store instead of AdMob (stable % per slot).
# EXPO_PUBLIC_DISCOVER_HOUSE_STORE_URL=https://your-store.example
# EXPO_PUBLIC_DISCOVER_HOUSE_AD_PCT=15
# EXPO_PUBLIC_DISCOVER_HOUSE_AD_TITLE=
# EXPO_PUBLIC_DISCOVER_HOUSE_AD_SUBTITLE=
# EXPO_PUBLIC_DISCOVER_HOUSE_AD_CTA=
# EXPO_PUBLIC_DISCOVER_HOUSE_AD_IMAGE_URL=
# Set to 1 to disable all ads (e.g. review builds)
# EXPO_PUBLIC_ADS_DISABLED=1
