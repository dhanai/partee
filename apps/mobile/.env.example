# Site ORIGIN only — do NOT append /api (paths are /api/users/me, etc.)
#
# Local testing against the cloud server (simplest on a real device; no LAN Next):
#   EXPO_PUBLIC_API_BASE_URL=https://your-app.vercel.app
#   EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=<publishable key for the SAME Clerk env as that deployment>
# Then: npx expo start -c
#
# Local Next instead: simulator → http://localhost:3000 ; device on Wi‑Fi → http://192.168.x.x:3000
# and from repo root `npm run dev:lan`.
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=
