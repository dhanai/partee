NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=

# Public support page (/support) and App Store “Support URL” — shown as the contact address (mailto)
# NEXT_PUBLIC_SUPPORT_EMAIL=support@parfade.com

# Round invite page: optional App Store / TestFlight link for “Get Parfade” (https://apps.apple.com/app/id…)
# NEXT_PUBLIC_IOS_APP_STORE_URL=

# Universal Links: production API/site at https://parfade.com (and www). AASA is at
# `/.well-known/apple-app-site-association`. `apps/mobile/app.json` lists `applinks:parfade.com` and `applinks:www.parfade.com`;
# rebuild iOS after changing domains. Android: use “Open in app” on the round page or add Digital Asset Links.
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=
# Optional for API boot; required for course search / place photos on web
NEXT_PUBLIC_GOOGLE_PLACES_API_KEY=
GOOGLE_PLACES_API_KEY=
DATABASE_URL=
# Optional: Neon “direct” connection for `npm run db:migrate` if migrate hangs (drizzle-kit + websocket driver).
# Also set if you use a pooler URL in DATABASE_URL and migrations fail. Falls back to DATABASE_URL.
# (drizzle.config normalizes sslmode to verify-full for migrate so `pg` v8 doesn’t print SSL deprecation noise.)
# DATABASE_URL_MIGRATE=

# Ably (server only) — used to mint tokens for mobile Ably Chat; create an API key in Ably dashboard.
ABLY_API_KEY=

# --- Database (Neon): do this for every new DB / branch / env ---
# Vercel does not run migrations for you unless you add a release step.
# With DATABASE_URL set (e.g. copy from Neon dashboard → .env.local):
#   1) npm run db:migrate          # apply migrations (uses `pg`/TCP; avoids drizzle-kit + Neon websocket hang). Pull latest + npm install if you only saw the websocket warning.
#   2) npm run db:ensure-user-columns   # idempotent repair if users.* columns still missing
# Symptoms of skipped (1)/(2): API 500s on /api/users/me, push-token, notification-badge, etc.

# Vercel Blob — required for image uploads on Vercel (mobile/web POST /api/uploads/event-image).
# Vercel dashboard → Storage → Blob → create store → attach to project (injects BLOB_READ_WRITE_TOKEN).
# Local dev without this uses public/uploads on disk instead.
BLOB_READ_WRITE_TOKEN=

# Expo push (server) — required for round-invite / follow-request notifications
# Token: https://expo.dev/accounts/[account]/settings/access-tokens
EXPO_ACCESS_TOKEN=
# Set to 1 to disable outbound push
# EXPO_PUSH_DISABLED=1
# Logs why push was skipped or send errors (invitees without tokens, missing EXPO_ACCESS_TOKEN, etc.)
# EXPO_DEBUG_PUSH=1
