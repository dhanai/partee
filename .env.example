NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=
NEXT_PUBLIC_GOOGLE_PLACES_API_KEY=
GOOGLE_PLACES_API_KEY=
DATABASE_URL=

# If the API errors on missing user columns (notifications / push), run:
#   npm run db:migrate
#   npm run db:ensure-user-columns

# Expo push (server) — required for round-invite / follow-request notifications
# Token: https://expo.dev/accounts/[account]/settings/access-tokens
EXPO_ACCESS_TOKEN=
# Set to 1 to disable outbound push
# EXPO_PUSH_DISABLED=1
# Logs why push was skipped or send errors (invitees without tokens, missing EXPO_ACCESS_TOKEN, etc.)
# EXPO_DEBUG_PUSH=1
